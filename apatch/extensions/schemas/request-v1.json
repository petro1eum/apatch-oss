{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://apatch.dev/schemas/apatch-extension-request-v1.schema.json",
  "title": "APatch extension process request v1",
  "type": "object",
  "required": [
    "protocol",
    "request_id",
    "tool_id",
    "workspace",
    "arguments"
  ],
  "additionalProperties": false,
  "properties": {
    "protocol": {
      "const": "apatch.extension.v1"
    },
    "request_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "tool_id": {
      "type": "string",
      "pattern": "^(?!apatch\\.)(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.){2,}[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?/[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
    },
    "workspace": {
      "type": "object",
      "required": [
        "root",
        "read_only"
      ],
      "additionalProperties": false,
      "properties": {
        "root": {
          "type": [
            "string",
            "null"
          ]
        },
        "read_only": {
          "const": true
        }
      }
    },
    "arguments": {}
  }
}
