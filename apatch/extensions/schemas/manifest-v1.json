{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://apatch.dev/schemas/apatch-extension-v1.schema.json",
  "title": "APatch extension manifest v1",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "version",
    "api_range",
    "owner",
    "license",
    "exportable",
    "notices",
    "capabilities",
    "artifacts",
    "package_sha256",
    "tools"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "maxLength": 253,
      "pattern": "^(?!apatch\\.)(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.){2,}[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "api_range": {
      "type": "object",
      "required": [
        "min",
        "max"
      ],
      "additionalProperties": false,
      "properties": {
        "min": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
        },
        "max": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
        }
      }
    },
    "owner": {
      "type": "object",
      "required": [
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "contact": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "license": {
      "type": "string",
      "minLength": 1,
      "maxLength": 192
    },
    "exportable": {
      "type": "boolean"
    },
    "notices": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*(?:[._:-][A-Za-z0-9_*-]+)*$"
      },
      "uniqueItems": true
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256"
        ],
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "package_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "tools": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "description",
          "authority",
          "input_schema",
          "output_schema",
          "runtime",
          "entrypoint",
          "argv",
          "timeout_sec",
          "max_output_bytes",
          "pass_env"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "authority": {
            "enum": [
              "read_only",
              "proposal"
            ]
          },
          "input_schema": {
            "type": "object"
          },
          "output_schema": {
            "type": "object"
          },
          "runtime": {
            "enum": [
              "python",
              "executable"
            ]
          },
          "entrypoint": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
          },
          "argv": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "timeout_sec": {
            "type": "integer",
            "minimum": 1,
            "maximum": 120
          },
          "max_output_bytes": {
            "type": "integer",
            "minimum": 256,
            "maximum": 1048576
          },
          "pass_env": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]{0,127}$"
            },
            "uniqueItems": true
          },
          "work_asset_ref": {
            "type": "string",
            "pattern": "^work_asset:[A-Za-z0-9][A-Za-z0-9._:-]{0,191}$"
          }
        }
      }
    }
  }
}
