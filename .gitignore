# apatch runtime (policy configs committed for dogfood gate)
.apatch/*
!.apatch/sandbox.json
!.apatch/enforcement.json
!.apatch/agent-identity.json
!.apatch/conformance.json
# Runtime inclusion records stay ignored. Publish selected, verified CI evidence
# explicitly as manifests/apatch-inclusion.jsonl.
# RFP-005 reality ledger: the observed-reality corpus is the source of truth — it must
# persist across checkouts (uncovered = derived debt), so it is committed like inclusion.
!.apatch/reality.jsonl
# .apatch/mcp.json holds an absolute, machine-specific interpreter path — it is
# generated per machine by `apatch mcp sync` / `apatch doctor`, never committed.

# IDE MCP stubs are machine-specific (absolute interpreter path) — generated per
# machine, never committed. Other .cursor/* (hooks, rules) stay tracked.
.cursor/mcp.json


# apatch runtime patches (generated, not source)
patches-*.jsonl
patches.jsonl
