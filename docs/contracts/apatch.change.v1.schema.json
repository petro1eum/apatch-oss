{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://apatch.dev/contracts/apatch.change.v1.schema.json",
  "title": "APatch Change v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "change_id",
    "execution_system",
    "tenant_id",
    "project_group_id",
    "source_kind",
    "work_program_id",
    "work_program_hash",
    "context_release_id",
    "context_release_manifest_hash",
    "spec_id",
    "spec_hash",
    "requirement_refs",
    "purpose_hash",
    "actor_key_id",
    "issued_at",
    "signature"
  ],
  "properties": {
    "schema": {"const": "apatch.change.v1"},
    "change_id": {"type": "string", "pattern": "^apchg_[0-9a-f]{32}$"},
    "execution_system": {"const": "apatch"},
    "tenant_id": {"type": "string", "minLength": 1},
    "project_group_id": {
      "type": "string",
      "pattern": "^tcpg_[0-9a-f]{32}$"
    },
    "source_kind": {"const": "work_program"},
    "work_program_id": {
      "type": "string",
      "pattern": "^tcwp_[0-9a-f]{32}$"
    },
    "work_program_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "context_release_id": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "context_release_manifest_hash": {
      "type": ["string", "null"],
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "spec_id": {"type": "string", "minLength": 1},
    "spec_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "requirement_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["requirement_id", "requirement_hash"],
        "properties": {
          "requirement_id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9._-]*[0-9]+$"
          },
          "requirement_hash": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{16}$"
          }
        }
      }
    },
    "purpose_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "actor_key_id": {"type": "string", "minLength": 1},
    "issued_at": {"type": "string", "format": "date-time"},
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "key_id", "value"],
      "properties": {
        "algorithm": {"const": "Ed25519"},
        "key_id": {"type": "string", "minLength": 1},
        "value": {"type": "string", "pattern": "^[A-Za-z0-9_-]{86}$"}
      }
    }
  },
  "allOf": [
    {
      "oneOf": [
        {
          "properties": {
            "context_release_id": {"type": "null"},
            "context_release_manifest_hash": {"type": "null"}
          }
        },
        {
          "properties": {
            "context_release_id": {"type": "string", "minLength": 1},
            "context_release_manifest_hash": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          }
        }
      ]
    }
  ]
}
