{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://apatch.dev/contracts/apatch.timesheet-draft.v1.schema.json",
  "title": "APatch Timesheet Draft v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "timesheet_id",
    "project_source_binding_id",
    "project_source_binding_hash",
    "subject_key_id",
    "period_started_at",
    "period_ended_at",
    "claimed_active_seconds",
    "session_refs",
    "contribution_event_refs",
    "issued_at",
    "signature"
  ],
  "properties": {
    "schema": {"const": "apatch.timesheet-draft.v1"},
    "timesheet_id": {"type": "string", "pattern": "^apts_[0-9a-f]{32}$"},
    "project_source_binding_id": {
      "type": "string",
      "pattern": "^tcpsb_[0-9a-f]{32}$"
    },
    "project_source_binding_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "subject_key_id": {"type": "string", "minLength": 1},
    "period_started_at": {"type": "string", "format": "date-time"},
    "period_ended_at": {"type": "string", "format": "date-time"},
    "claimed_active_seconds": {"type": "integer", "minimum": 0},
    "session_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["governed_session_id", "started_at", "ended_at"],
        "properties": {
          "governed_session_id": {"type": "string", "minLength": 1},
          "started_at": {"type": "string", "format": "date-time"},
          "ended_at": {"type": "string", "format": "date-time"}
        }
      }
    },
    "contribution_event_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["event_id", "event_hash"],
        "properties": {
          "event_id": {"type": "string", "minLength": 1},
          "event_hash": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        }
      }
    },
    "issued_at": {"type": "string", "format": "date-time"},
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "key_id", "value"],
      "properties": {
        "algorithm": {"const": "Ed25519"},
        "key_id": {"type": "string", "minLength": 1},
        "value": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{86}$"
        }
      }
    }
  }
}
